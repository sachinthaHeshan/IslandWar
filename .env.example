# Docker Compose and local development; replace these values before sharing a deployment.
POSTGRES_USER=islandwar
POSTGRES_DB=islandwar
POSTGRES_PASSWORD=islandwar_local_dev
DATABASE_URL=postgres://islandwar:islandwar_local_dev@127.0.0.1:5432/islandwar?sslmode=disable
TEST_DATABASE_URL=postgres://islandwar:islandwar_local_dev@127.0.0.1:5432/islandwar_test?sslmode=disable
APP_ORIGIN=http://localhost:5173
# Comma-separated origins for local browser access; keep this exact in production.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GAME_ORIGIN=http://localhost:8080
ADDR=:8080
COOKIE_SECURE=false
STATIC_DIR=../frontend/dist
